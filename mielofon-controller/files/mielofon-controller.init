#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034          # consumed by /etc/rc.common
# shellcheck shell=sh                # busybox ash (OpenWrt); `local` is fine
# shellcheck disable=SC3043          # `local` is supported by the target ash
START=95
STOP=10
USE_PROCD=1

# `key = "value"` of the first `$2` assignment in the TOML, or `$3` when
# absent. Good enough for the flat, quoted paths of the `[tls]` section.
toml_path() {
	local v
	v="$(sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" 2>/dev/null | head -n 1)"
	echo "${v:-$3}"
}

# The package ships in images for every node, but only hubs carry the TLS
# material. Without it the daemon can only exit, so refuse to start instead
# of letting procd respawn it until it gives up: a node that is not a hub
# stays quiet.
configured() {
	local config="$1" f
	for f in \
		"$(toml_path "$config" ca /etc/mielofon/ca.pem)" \
		"$(toml_path "$config" cert /etc/mielofon/node.pem)" \
		"$(toml_path "$config" key /etc/mielofon/node.key)"; do
		if [ ! -r "$f" ]; then
			logger -t mielofon-controller -p daemon.notice \
				"not starting: $f missing (this node is not a configured hub)"
			return 1
		fi
	done
	return 0
}

start_service() {
	config_load mielofon-controller

	local enabled config backtrace
	config_get_bool enabled main enabled 1
	config_get config main config '/etc/mielofon/mielofon-controller.toml'
	config_get_bool backtrace main backtrace 0

	[ "$enabled" -eq 1 ] || return
	configured "$config" || return

	procd_open_instance
	procd_set_param command /usr/sbin/mielofon-controller daemon "$config"
	[ "$backtrace" -eq 1 ] && procd_set_param env RUST_BACKTRACE=1
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mielofon-controller"
}
