# Mielofon agent configuration (SANITIZED example).
#
# The agent pulls commands from the controller over a long-lived mTLS
# long-poll, reports link measurements, and applies the OSPF cost it is told
# to apply. All addresses below are placeholders (RFC 5737 / RFC 3849).
#
# Links are AUTO-DISCOVERED from BIRD/OSPF, not listed per-link: the agent
# reads `bird status` (rpcd-mod-bird) and matches the mesh OSPF protocol's
# point-to-point interfaces against BGP peer protocol names
# (`peer_<node>_<domain>`) to recover the peer; probe source/target come from
# the interface's own IPv6 address (far side of the /127). Only an exclude
# list is needed when a discovered interface must stay unmanaged.

config agent 'main'
	# Log verbosity: debug < info (= notice) < warning < err.
	option log_level 'notice'
	# Agent identity. Empty/defaults to the router hostname.
	option agent_name 'spoke-1'
	# Controller clients listener (mTLS). Full URL including scheme and port.
	option controller_url 'https://203.0.113.1:9552'
	# mTLS client identity (deployed by the operator, never shipped):
	option cacert '/etc/mielofon/ca.pem'
	option cert    '/etc/mielofon/agent.cer'
	option key     '/etc/mielofon/agent.key'
	# Long-poll hold for /v1/agent/command (ms).
	option command_timeout_ms '30000'
	# OSPF protocol whose point-to-point interfaces are managed links.
	# Nodes may run unrelated OSPF instances; they are ignored.
	option ospf_protocol 'mesh_v3'
	# The peer node identifier comes straight from the BGP peer protocol name
	# (peer_<hostname>, dots as underscores) — never shortened. An interface
	# is matched to a peer by its short label: the first dot-label of the
	# peer hostname (awg_hub1 <-> hub1.example.com), so only the prefix
	# convention is configured here:
	#   awg_hub1 minus "awg_" -> "hub1" (matches the peer hostname's first label)
	option iface_prefix 'awg_'
	# Interface holding the mesh loopback, reported for the trace walker.
	option loopback_iface 'dummy_awg'
	# Continuous ICMP cadence per managed link (seconds, fractional allowed)
	# and the rolling window (pings) rtt/jitter/loss are computed over.
	option ping_interval '1'
	option ping_window '60'
	# Quiet threshold in Mbps: above this the throughput test is skipped.
	option quiet_max_mbps '15'
	# Duration (seconds) of the gated TCP throughput test (iperf3 upload to
	# the peer).
	option tcp_duration '4'
	# Peer iperf3 server port; keep in sync with the iperf3-server listener.
	option iperf_port '5201'
	# UDP leg of the gated test: a fixed-rate stream right after the TCP
	# upload, reporting what the peer received, its jitter and packet loss
	# (the raw path, free of TCP's congestion control). `udp_rate_mbps` 0
	# disables the leg; `udp_port` unset reuses iperf_port.
	option udp_rate_mbps '20'
	# option udp_port '5202'
	# Link re-discovery cadence (seconds, min 10): `bird status` and netifd
	# over ubus/ucode, plus the check that BIRD still carries the applied
	# costs (a config redeploy resets them). Each run costs rpcd work, so
	# keep it at a minute or more.
	option refresh_interval '60'
	# Optional Prometheus textfile (node-exporter collector), rewritten
	# atomically every prometheus_interval seconds. Empty disables.
	# option prometheus_textfile '/run/prometheus/textfile/mielofon-agent.prom'
	option prometheus_interval '20'

# Discovered interfaces to leave unmanaged (never probed or cost-driven).
# Matches on interface name.
# config exclude
# 	option interface 'dummy_awg'
