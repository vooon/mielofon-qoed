-- Testcase --
import { parse_ping, parse_transaction_rate, parse_iperf3 } from 'probes';

let p = parse_ping(
	'PING 2001:db8::1 (2001:db8::1) 56 data bytes\n' +
	'\n' +
	'--- 2001:db8::1 ping statistics ---\n' +
	'3 packets transmitted, 3 received, 0% packet loss, time 402ms\n' +
	'rtt min/avg/max/mdev = 11.057/11.741/12.402/0.551 ms\n'
);

if (p.loss != 0)
	die('loss mismatch: ' + p.loss);

if (!(p.rtt > 11 && p.rtt < 12))
	die('rtt mismatch: ' + p.rtt);

/* busybox: 100% loss drops the round-trip line entirely → rtt null. */
let p2 = parse_ping(
	'PING fd00:0:0:1::1 (fd00:0:0:1::1): 56 data bytes\n' +
	'\n' +
	'--- fd00:0:0:1::1 ping statistics ---\n' +
	'3 packets transmitted, 0 packets received, 100% packet loss\n'
);

if (p2.loss != 100)
	die('busybox loss mismatch: ' + p2.loss);

if (p2.rtt != null)
	die('busybox failed ping must not carry an rtt: ' + p2.rtt);

/* iputils on 100% loss still prints a 0.000 summary → callers null it. */
let p3 = parse_ping(
	'--- fd00:0:0:1::1 ping statistics ---\n' +
	'3 packets transmitted, 0 received, 100% packet loss, time 3ms\n' +
	'rtt min/avg/max/mdev = 0.000/0.000/0.000/0.000 ms\n'
);

if (p3.loss != 100 || p3.rtt != 0)
	die('iputils 100%% loss parse mismatch: loss=' + p3.loss + ' rtt=' + p3.rtt);

let t = parse_transaction_rate(
	'Socket Message Elapsed Messages\n' +
	'\n' +
	'Size Size Time Okay Errors Throughput\n' +
	'bytes bytes secs # # 10^6ops/sec\n' +
	'\n' +
	'0 0 4.00 903 0 225.75\n'
);

if (t != 225.75)
	die('tps mismatch: ' + t);

let m = parse_iperf3('{"end":{"sum_received":{"bits_per_second":100000000}}}');

if (m == null || !(m > 99 && m < 101))
	die('tcp mismatch: ' + m);

print('OK\n');
-- Expect stdout --
OK
-- Expect exitcode --
0
-- End --
