-- Testcase --
import * as ad from 'autodiscover';

/* Node with two OSPF instances: mesh (ptp awg_* + broadcast stub) and an
 * unrelated IPv4 OSPF on eth2/eth3 which must be ignored. */
let status = {
	ospf: [
		{
			protocol: 'mesh_v3',
			ip_version: '6',
			interfaces: [
				{ interface: 'dummy_awg', type: 'broadcast', cost: 10 },
				{ interface: 'awg_hub1', type: 'ptp', cost: 10 },
				{ interface: 'awg_hub2', type: 'ptp', cost: 10 },
				{ interface: 'awg_legacy', type: 'ptp', cost: 10 },
			],
		},
		{
			protocol: 'werther_v2',
			ip_version: '4',
			interfaces: [
				{ interface: 'eth2', type: 'ptp', cost: 10 },
				{ interface: 'eth3', type: 'ptp', cost: 10 },
			],
		},
	],
	bgp: [
		{ name: 'peer_hub1_example_com', state: 'Established' },
		{ name: 'peer_hub2_example_com', state: 'Established' },
		/* hub3 has a BGP session but no awg_* OSPF interface: no link */
		{ name: 'peer_hub3_example_com', state: 'Established' },
	],
};

let cfg = {
	ospf_protocol: 'mesh_v3',
	iface_prefix: 'awg_',
	excludes: [ 'awg_legacy' ],
};

let links = ad.select_links(status, cfg);

if (length(links) != 2)
	die('expected 2 links, got ' + length(links) +
	    ' (broadcast stub + excluded + eth* must be filtered)');

if (links[0].interface != 'awg_hub1' || links[0].to != 'hub1.example.com')
	die('link[0] mismatch: ' + links[0].interface + ' -> ' + links[0].to);

if (links[1].interface != 'awg_hub2' || links[1].to != 'hub2.example.com')
	die('link[1] mismatch: ' + links[1].interface + ' -> ' + links[1].to);

/* peer_hostname / peer_short_label / iface_token */
if (ad.peer_hostname('peer_hub1_example_com') != 'hub1.example.com')
	die('peer_hostname failed');
if (ad.peer_hostname('peer_nr') != 'nr')
	die('peer_hostname (dotless) failed');
if (ad.peer_hostname('other_proto') != null)
	die('non-peer protocol name should be rejected');
if (ad.peer_hostname('peer_') != null)
	die('empty peer name should be rejected');

if (ad.peer_short_label('hub1.example.com') != 'hub1')
	die('peer_short_label failed');
if (ad.peer_short_label('nr') != 'nr')
	die('peer_short_label (dotless) failed');

if (ad.iface_token('awg_hub1', 'awg_') != 'hub1')
	die('iface_token failed');

/* derive_address: pick the /127 global, target = far side */
let net = {
	'ipv6-address': [
		{ address: 'fe80::4243:40:1', mask: 64 },
		{ address: 'fd00:0:0:1::40:1', mask: 127 },
	],
};

let a = ad.derive_address(net);

if (a == null)
	die('derive_address returned null');

if (a.source != 'fd00:0:0:1::40:1')
	die('source mismatch: ' + a.source);

if (a.target != 'fd00:0:0:1::40:0')
	die('target mismatch (far /127 side expected): ' + a.target);

/* no usable global v6 -> null */
if (ad.derive_address({ 'ipv6-address': [ { address: 'fe80::1', mask: 64 } ] }) != null)
	die('link-local-only interface should be rejected');

if (ad.derive_address(null) != null)
	die('null interface status should be rejected');

/* discover() end-to-end with a fake bus */
let bus = {
	status: function() { return status; },
	iface: function(name) {
		return {
			'ipv6-address': [
				{ address: 'fd00:0:0:1::40:1', mask: 127 },
			],
		};
	},
};

let all = ad.discover(cfg, bus);

if (length(all) != 2)
	die('discover() expected 2 links, got ' + length(all));

if (all[0].source != 'fd00:0:0:1::40:1' || all[0].target != 'fd00:0:0:1::40:0')
	die('discover() address derivation mismatch');

print('OK\n');
-- Expect stdout --
OK
-- Expect exitcode --
0
