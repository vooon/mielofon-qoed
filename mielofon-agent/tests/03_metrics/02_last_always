-- Testcase --
import * as metrics from 'metrics';

let link = { from: 'spoke-1', to: 'hub-a', interface: 'awg_hub_a' };

/* No measurement yet → all null. */
let a = metrics.last_always(link);

if (a.rtt_ms != null || a.loss_pct != null || a.jitter_ms != null)
	die('no always record yet must echo nulls');

metrics.record_always(link, { rtt_ms: 12.3, loss_pct: 0.5, jitter_ms: 3.1 });

a = metrics.last_always(link);

if (a.rtt_ms != 12.3 || a.loss_pct != 0.5 || a.jitter_ms != 3.1)
	die('last_always must echo the always record');

/* A throughput run (or idle) must not clobber the always dims. */
metrics.record_throughput(link, { util_mbps: 3.0, tcp_mbps: 40, busy: 0 });

a = metrics.last_always(link);

if (a.rtt_ms != 12.3 || a.jitter_ms != 3.1)
	die('throughput must preserve last_always');

/* A fresh always record that could not measure (rtt null) is echoed as null —
 * never a stale value (this is what removes the 100%-loss stale-rtt rows). */
metrics.record_always(link, { rtt_ms: null, loss_pct: 100, jitter_ms: null });

a = metrics.last_always(link);

if (a.rtt_ms != null || a.loss_pct != 100 || a.jitter_ms != null)
	die('unmeasured always dims must echo null, not stale');

print('OK\n');
-- Expect stdout --
OK
-- Expect exitcode --
0
-- End --
