#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034          # consumed by /etc/rc.common
USE_PROCD=1

START=95
STOP=10

start_service()
{
	local port bind extra

	config_load iperf3-server
	config_get_bool enabled main enabled 1
	[ "$enabled" = "0" ] && return 0

	config_get port main port 5201
	config_get bind main bind ""
	config_get extra main extra ""

	procd_open_instance
	procd_set_param command /usr/bin/iperf3 -s -p "$port"
	[ -n "$bind" ] && procd_append_param command -B "$bind"
	[ -n "$extra" ] && procd_append_param command $extra
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger "iperf3-server"
}
